// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  username               String?   @unique // สำหรับลูกบ้านใช้ล็อกอินด้วยรหัสห้อง (เช่น AP-001)
  emailVerified          DateTime?
  password               String?
  name                   String?
  image                  String?
  lineChannelAccessToken String? // สำหรับเก็บ Channel Access Token ของ LINE OA บอต
  lineUserId             String? // สำหรับเก็บ LINE User ID ส่วนบุคคลของผู้ใช้งานเพื่อรับแจ้งเตือน
  lineBindingCode        String? // สำหรับรหัสผูกบัญชีชั่วคราว (เช่น JAD-1234)
  role                   Role      @default(TENANT)
  pdpaAcceptedAt         DateTime? // เก็บวันที่กดยอมรับ PDPA
  planTier               PlanTier  @default(FREE_TRIAL)
  planExpiresAt          DateTime? // วันหมดอายุแพ็กเกจ (ถ้าหมดแล้วอาจจะใช้งานต่อไม่ได้ถ้าไม่ต่ออายุ)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  properties        Property[] // สำหรับ Owner
  tenantProfile     Tenant? // สำหรับ Tenant
  accounts          Account[]
  sessions          Session[]
  invoices          Invoice[] // ใบแจ้งหนี้ค่าบริการ SaaS (สำหรับ Owner)
  smsAddon          SmsAddon? // แพ็กเกจเสริม SMS (สำหรับ Owner)
  registrationCodes RegistrationCode[] // โค้ดที่ User คนนี้สร้าง หรือใช้งาน
}

enum Role {
  ADMIN
  OWNER
  TENANT
}

enum PlanTier {
  FREE_TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

model Property {
  id            String  @id @default(cuid())
  name          String
  address       String
  imageUrl      String? // ภาพปกของหอพัก
  leaseTemplate String? // ข้อความ/เงื่อนไขสัญญาเช่าที่ปรับแต่งได้

  // Billing & Legal Settings
  taxId         String? // เลขประจำตัวผู้เสียภาษี
  companyName   String? // ชื่อบริษัท/ชื่อจดทะเบียน
  promptPayNo   String? // เบอร์พร้อมเพย์
  promptPayName String? // ชื่อบัญชีพร้อมเพย์
  signatureUrl  String? // ลายเซ็นผู้รับเงิน (Base64 หรือ URL)

  // Utility Rates & Default Fees
  electricRate       Float? // ค่าไฟต่อหน่วย
  waterRate          Float? // ค่าน้ำต่อหน่วย (หรือเหมาจ่าย)
  defaultCommonFee   Float? // ค่าส่วนกลาง (Default)
  defaultParkingFee  Float? // ค่าที่จอดรถ (Default)
  defaultInternetFee Float? // ค่าอินเทอร์เน็ต (Default)

  // ── ค่าเริ่มต้นสำหรับ "บิลเข้าอยู่" (Check-in) ──
  defaultSecurityDeposit Float? // เงินประกันห้อง (ถ้าไม่ตั้ง จะ default = ค่าเช่า 1 เดือน)
  defaultAdvanceRent     Float? // ค่าเช่าล่วงหน้า
  defaultKeyDeposit      Float? // ค่ามัดจำกุญแจ/คีย์การ์ด
  defaultCarFee          Float? // ค่าลงทะเบียน/ที่จอด รถยนต์ (0 = ฟรี)
  defaultMotorcycleFee   Float? // ค่าลงทะเบียน/ที่จอด มอเตอร์ไซค์ (0 = ฟรี)

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

model Room {
  id            String               @id @default(cuid())
  number        String
  floor         String?
  rentPrice     Float
  imageMain     String? // ภาพรวมห้องนอน/ห้องนั่งเล่น
  imageBathroom String? // ภาพห้องน้ำ
  imageBalcony  String? // ภาพระเบียง/วิว
  imageFacility String? // ภาพสิ่งอำนวยความสะดวก
  inviteCode    String?              @unique // รหัสสำหรับให้ลูกบ้านใช้สมัครสมาชิกเข้าห้องนี้
  propertyId    String
  property      Property             @relation(fields: [propertyId], references: [id])
  tenants       Tenant[]
  bills         Bill[]
  maintenance   MaintenanceRequest[]
  parcels       Parcel[]
  status        RoomStatus           @default(AVAILABLE)

  // Amenities
  hasAircon    Boolean @default(false)
  hasFan       Boolean @default(false)
  hasFurniture Boolean @default(false)

  // Meters
  waterMeterStart    Float? @default(0) // เลขมิเตอร์น้ำตั้งต้นตอนย้ายเข้า
  electricMeterStart Float? @default(0) // เลขมิเตอร์ไฟตั้งต้นตอนย้ายเข้า

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@unique([propertyId, number])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model Tenant {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  roomId        String?
  room          Room?     @relation(fields: [roomId], references: [id])
  leaseStart    DateTime?
  leaseEnd      DateTime?
  depositAmount Float?
  lineUserId    String?   @unique

  // ── ข้อมูลส่วนตัวตามกฎหมาย ──
  firstName        String? // ชื่อจริง (ภาษาไทย)
  lastName         String? // นามสกุล (ภาษาไทย)
  idCardNumber     String? // เลขบัตรประชาชน 13 หลัก
  phoneNumber      String?   @unique // เบอร์โทร
  address          String?   @db.Text // ที่อยู่ตามทะเบียนบ้าน
  emergencyContact String? // ชื่อผู้ติดต่อฉุกเฉิน
  emergencyPhone   String? // เบอร์ผู้ติดต่อฉุกเฉิน
  moveInDate       DateTime? // วันย้ายเข้าจริง
  profileCompleted Boolean   @default(false) // กรอกข้อมูลครบแล้วหรือยัง

  vehicles Vehicle[] // ยานพาหนะที่ลงทะเบียน

  // E-Contract Fields
  signatureUrl      String?   @db.Text
  contractSignedAt  DateTime?
  contractIpAddress String?
  contractUserAgent String?
  contractPdfUrl    String?   @db.Text // สำหรับเก็บไฟล์ PDF สัญญา หรือสลิปสัญญาที่อัปโหลด

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

model Vehicle {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  licensePlate String // ทะเบียนรถ เช่น กก 1234
  brand        String? // ยี่ห้อ เช่น Honda, Toyota
  color        String? // สี
  type         VehicleType @default(MOTORCYCLE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum VehicleType {
  CAR
  MOTORCYCLE
  OTHER
}

model Bill {
  id              String   @id @default(cuid())
  type            BillType @default(MONTHLY) // MONTHLY = บิลรายเดือน, CHECKIN = บิลเข้าอยู่
  month           Int
  year            Int
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id])
  rentAmount      Float
  waterAmount     Float
  waterUnits      Float?
  waterReading    Float?
  electricAmount  Float
  electricUnits   Float?
  electricReading Float?
  commonFee       Float    @default(0)
  parkingFee      Float    @default(0)
  internetFee     Float    @default(0)
  otherFee        Float    @default(0)

  // ── ฟิลด์เฉพาะบิลเข้าอยู่ (Check-in) ──
  securityDeposit Float @default(0) // เงินประกันห้อง (คืนได้ตอนย้ายออก)
  advanceRent     Float @default(0) // ค่าเช่าล่วงหน้า
  keyDeposit      Float @default(0) // ค่ามัดจำกุญแจ/คีย์การ์ด
  vehicleFee      Float @default(0) // ค่าลงทะเบียน/ที่จอดรถ

  balanceForward Float      @default(0) // ยอดค้างชำระยกมา
  totalAmount    Float
  paidAmount     Float      @default(0) // ยอดที่ชำระแล้ว
  status         BillStatus @default(UNPAID)
  dueDate        DateTime
  slipUrl        String? // ลิงก์/รูปสลิปโอนเงิน
  paymentDate    DateTime? // วันที่ผู้เช่าส่งสลิป
  payments       Payment[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  isDeleted      Boolean    @default(false)

  @@unique([roomId, month, year, type])
}

enum BillType {
  MONTHLY
  CHECKIN
}

enum BillStatus {
  UNPAID
  PENDING // รอตรวจสอบสลิป
  PARTIAL // จ่ายไม่ครบ
  PAID
  OVERDUE
}

model Payment {
  id         String        @id @default(cuid())
  billId     String
  bill       Bill          @relation(fields: [billId], references: [id])
  amount     Float
  slipUrl    String?
  status     PaymentStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model MaintenanceRequest {
  id            String            @id @default(cuid())
  roomId        String
  room          Room              @relation(fields: [roomId], references: [id])
  title         String
  description   String
  imageUrl      String?
  status        MaintenanceStatus @default(PENDING)
  preferredAt   DateTime? // วันเวลาที่ผู้เช่าสะดวกรับช่าง (แจ้งตอน submit)
  scheduledAt   DateTime? // วันเวลานัดหมายยืนยันโดยเจ้าของ
  scheduledNote String? // หมายเหตุการนัดหมาย
  // AI categorization fields
  aiCategory    String? // หมวดหมู่ที่ AI จัดให้ (เช่น ระบบปรับอากาศ, ประปา, ไฟฟ้า)
  aiUrgency     String? // ความเร่งด่วน: สูง/กลาง/ต่ำ
  aiTechnician  String? // ประเภทช่างที่แนะนำ (เช่น ช่างแอร์, ช่างประปา)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  isDeleted     Boolean           @default(false)
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Parcel {
  id             String       @id @default(cuid())
  trackingNumber String?
  recipientName  String?
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id])
  status         ParcelStatus @default(PENDING)
  receivedAt     DateTime     @default(now())
  pickedUpAt     DateTime?
  isDeleted      Boolean      @default(false)
}

enum ParcelStatus {
  PENDING
  PICKED_UP
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------
// SaaS Admin Models
// -----------------------------------------

model SystemSettings {
  id              String   @id @default(cuid())
  heroHeadline    String?
  heroSubheadline String?
  heroImageUrl    String?
  contactEmail    String?
  contactPhone    String?
  pricingMonthly  Float?   @default(500)
  pricingYearly   Float?   @default(5000)
  updatedAt       DateTime @updatedAt
}

/// ใบแจ้งหนี้รายเดือนสำหรับเรียกเก็บค่าบริการ JadHor OS จากเจ้าของหอพัก
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // เลขที่ใบแจ้งหนี้ เช่น INV-202606-0001
  ownerId       String
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  month         Int // เดือนที่เรียกเก็บ
  year          Int // ปีที่เรียกเก็บ
  items         InvoiceItem[] // รายการย่อยทั้งหมดในบิลใบนี้
  totalAmount   Float // ยอดรวมสุทธิ (คำนวณจาก items)
  status        BillStatus    @default(UNPAID)
  slipUrl       String? // URL สลิปโอนเงินที่เจ้าของหอแนบมา
  paidAt        DateTime? // วันเวลาที่ Admin อนุมัติ (หรือ auto-verify)
  dueDate       DateTime? // วันครบกำหนดชำระ
  note          String? // หมายเหตุจาก Admin

  // SlipOK verification results
  slipVerified  Boolean?  @default(false) // ผ่านการตรวจอัตโนมัติหรือไม่
  slipAmount    Float?    // ยอดเงินที่อ่านได้จากสลิป
  slipTransRef  String?   // เลขอ้างอิงรายการ (กันซ้ำ)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([ownerId, month, year])
}

/// รายการย่อยในใบแจ้งหนี้ (1 Invoice → หลาย InvoiceItem)
model InvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        InvoiceItemType // ประเภทรายการ
  description String // คำอธิบายภาษาไทย
  quantity    Int             @default(1)
  unitPrice   Float // ราคาต่อหน่วย
  amount      Float // ยอดรวม (quantity × unitPrice)
  createdAt   DateTime        @default(now())
}

enum InvoiceItemType {
  PLATFORM_FEE // ค่าบริการระบบหลัก
  SMS_ADDON // แพ็กเกจเสริม SMS
  DISCOUNT // ส่วนลด
  OTHER // อื่นๆ
}

/// แพ็กเกจเสริม SMS ที่เจ้าของหอพักสมัครใช้งาน
model SmsAddon {
  id         String   @id @default(cuid())
  ownerId    String   @unique // 1 Owner → 1 SmsAddon record
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tier       SmsTier  @default(SIZE_S)
  quota      Int // โควตาข้อความต่อเดือน (50/120/250)
  used       Int      @default(0) // จำนวนข้อความที่ใช้ไปแล้วในเดือนนี้
  resetMonth Int // เดือนที่จะ reset used เป็น 0
  resetYear  Int // ปีที่จะ reset used เป็น 0
  isActive   Boolean  @default(true)

  // Thaibulksms API credentials (เก็บ per-owner)
  thaibulkApiKey    String? // API Key จาก Thaibulksms
  thaibulkApiSecret String? // API Secret จาก Thaibulksms
  thaibulkSenderId  String? @default("JadHor") // Sender name บน SMS (max 11 chars)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SmsTier {
  SIZE_S // 50 ข้อความ/เดือน — 99 บาท
  SIZE_M // 120 ข้อความ/เดือน — 199 บาท
  SIZE_L // 250 ข้อความ/เดือน — 349 บาท
}

model RegistrationCode {
  id        String   @id @default(cuid())
  code      String   @unique
  months    Int      @default(1) // ระยะเวลาที่ใช้งานได้ (เดือน)
  isUsed    Boolean  @default(false)
  usedById  String?
  usedBy    User?    @relation(fields: [usedById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
