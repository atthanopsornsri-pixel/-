// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique // สำหรับลูกบ้านใช้ล็อกอินด้วยรหัสห้อง (เช่น AP-001)
  emailVerified DateTime?
  password      String?
  unencryptedPassword String? // เก็บตามที่ผู้ใช้ร้องขอ เพื่อให้ Admin/Owner ดูรหัสผ่านได้
  name          String?
  image         String?
  lineToken     String?  // สำหรับผูก LINE Notify
  role          Role      @default(TENANT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  properties    Property[] // สำหรับ Owner
  tenantProfile Tenant?    // สำหรับ Tenant
  accounts      Account[]
  sessions      Session[]
  subscriptionBills SubscriptionBill[] // สำหรับ Owner
  registrationCodes RegistrationCode[] // โค้ดที่ User คนนี้สร้าง หรือใช้งาน
}

enum Role {
  ADMIN
  OWNER
  TENANT
}

model Property {
  id            String   @id @default(cuid())
  name          String
  address       String
  imageUrl      String?  // ภาพปกของหอพัก
  leaseTemplate String?  // ข้อความ/เงื่อนไขสัญญาเช่าที่ปรับแต่งได้
  
  // Billing & Legal Settings
  taxId         String?  // เลขประจำตัวผู้เสียภาษี
  companyName   String?  // ชื่อบริษัท/ชื่อจดทะเบียน
  promptPayNo   String?  // เบอร์พร้อมเพย์
  promptPayName String?  // ชื่อบัญชีพร้อมเพย์
  signatureUrl  String?  // ลายเซ็นผู้รับเงิน (Base64 หรือ URL)

  // Utility Rates & Default Fees
  electricRate      Float?  // ค่าไฟต่อหน่วย
  waterRate         Float?  // ค่าน้ำต่อหน่วย (หรือเหมาจ่าย)
  defaultCommonFee  Float?  // ค่าส่วนกลาง (Default)
  defaultParkingFee Float?  // ค่าที่จอดรถ (Default)
  defaultInternetFee Float? // ค่าอินเทอร์เน็ต (Default)

  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  rooms         Room[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDeleted     Boolean  @default(false)
}

model Room {
  id          String   @id @default(cuid())
  number      String
  floor       String?
  rentPrice     Float
  imageMain     String?  // ภาพรวมห้องนอน/ห้องนั่งเล่น
  imageBathroom String?  // ภาพห้องน้ำ
  imageBalcony  String?  // ภาพระเบียง/วิว
  imageFacility String?  // ภาพสิ่งอำนวยความสะดวก
  inviteCode    String?  @unique // รหัสสำหรับให้ลูกบ้านใช้สมัครสมาชิกเข้าห้องนี้
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  tenants     Tenant[]
  bills       Bill[]
  maintenance MaintenanceRequest[]
  parcels     Parcel[]
  status      RoomStatus @default(AVAILABLE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@unique([propertyId, number])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model Tenant {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  roomId        String?
  room          Room?     @relation(fields: [roomId], references: [id])
  leaseStart    DateTime?
  leaseEnd      DateTime?
  depositAmount Float?
  idCardNumber  String?
  phoneNumber   String?   @unique
  lineUserId    String?   @unique

  // E-Contract Fields
  signatureUrl      String?   @db.Text
  contractSignedAt  DateTime?
  contractIpAddress String?
  contractUserAgent String?
  contractPdfUrl    String?   @db.Text // สำหรับเก็บไฟล์ PDF สัญญา หรือสลิปสัญญาที่อัปโหลด

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
}

model Bill {
  id             String    @id @default(cuid())
  month          Int
  year           Int
  roomId         String
  room           Room      @relation(fields: [roomId], references: [id])
  rentAmount     Float
  waterAmount    Float
  waterUnits     Float?
  electricAmount Float
  electricUnits  Float?
  commonFee      Float     @default(0)
  parkingFee     Float     @default(0)
  internetFee    Float     @default(0)
  otherFee       Float     @default(0)
  totalAmount    Float
  status         BillStatus @default(UNPAID)
  dueDate        DateTime
  slipUrl        String?    // ลิงก์/รูปสลิปโอนเงิน
  paymentDate    DateTime?  // วันที่ผู้เช่าส่งสลิป
  payments       Payment[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isDeleted      Boolean   @default(false)

  @@unique([roomId, month, year])
}

enum BillStatus {
  UNPAID
  PENDING   // รอตรวจสอบสลิป
  PAID
  OVERDUE
}

model Payment {
  id           String    @id @default(cuid())
  billId       String
  bill         Bill      @relation(fields: [billId], references: [id])
  amount       Float
  slipUrl      String?
  status       PaymentStatus @default(PENDING)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model MaintenanceRequest {
  id           String    @id @default(cuid())
  roomId       String
  room         Room      @relation(fields: [roomId], references: [id])
  title        String
  description  String
  imageUrl     String?
  status       MaintenanceStatus @default(PENDING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Parcel {
  id              String       @id @default(cuid())
  trackingNumber  String?
  recipientName   String?
  roomId          String
  room            Room         @relation(fields: [roomId], references: [id])
  status          ParcelStatus @default(PENDING)
  receivedAt      DateTime     @default(now())
  pickedUpAt      DateTime?
  isDeleted       Boolean      @default(false)
}

enum ParcelStatus {
  PENDING
  PICKED_UP
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------
// SaaS Admin Models
// -----------------------------------------

model SystemSettings {
  id              String   @id @default(cuid())
  heroHeadline    String?
  heroSubheadline String?
  heroImageUrl    String?
  contactEmail    String?
  contactPhone    String?
  pricingMonthly  Float?   @default(500)
  pricingYearly   Float?   @default(5000)
  updatedAt       DateTime @updatedAt
}

model SubscriptionBill {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  amount      Float
  status      BillStatus @default(UNPAID)
  slipUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RegistrationCode {
  id          String   @id @default(cuid())
  code        String   @unique
  months      Int      @default(1) // ระยะเวลาที่ใช้งานได้ (เดือน)
  isUsed      Boolean  @default(false)
  usedById    String?
  usedBy      User?    @relation(fields: [usedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
